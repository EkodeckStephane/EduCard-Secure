# EduCard Secure local configuration example.
# Copy to .env locally and replace placeholders outside Git.
# Never commit .env or real secrets.

APP_ENV=development
APP_NAME=EduCard Secure
APP_DEBUG=false

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# MySQL 5.7 local target.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=educard_secure
DATABASE_USER=educard_app
DATABASE_PASSWORD=
DATABASE_URL=

# Legacy aliases kept empty for compatibility during transition.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=educard_secure
MYSQL_USER=educard_app
MYSQL_PASSWORD=

# Secrets must be generated locally and never committed.
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
QR_SIGNING_PRIVATE_KEY_PATH=
QR_SIGNING_PUBLIC_KEY_PATH=
SESSION_COOKIE_NAME=educard_session
CSRF_COOKIE_NAME=educard_csrf
BACKUP_SERVICE_TOKEN=
DEMO_PRIVILEGED_TOTP_SECRET=

# Demo data must remain synthetic.
DEMO_DATA_ENABLED=true
